{
  "version": 2,
  "framework": null,
  "buildCommand": "yarn vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "Club Polanco",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:+wzgZpWGbQxS/Wu7ms7qWibqCjsurduE5DGFw66I+3U=",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}
